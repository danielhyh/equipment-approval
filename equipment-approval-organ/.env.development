# 开发环境
VITE_ENV=development

# 开发环境请求接口地址
# - 请求地址
VITE_API = 'http://192.168.1.34:48080'
# VITE_API = 'http://172.29.77.100:48080'
# VITE_API = 'http://113.45.143.70:48090'
# - 图片前缀
VITE_FILE_PREFIX = ''

# 本地开发代理，可以解决跨域及多地址代理
# 如果接口地址匹配到，则会转发到http://localhost:3200，防止本地出现跨域问题
# 可以有多个，注意多个不能换行，否则代理将会失效
VITE_PROXY = [["/api","http://192.168.2.230:3125/api-test"]]
VITE_BASE_URL = '/'

# 是否启用单点登录 SSO
VITE_ENABLE_SSO = true